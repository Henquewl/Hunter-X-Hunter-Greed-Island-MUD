# Compiled binaries
bin/*
!bin/.gitkeep
src/*.o
src/util/*.o

# Player data (never version): everything under plrfiles/plrobjs except
# the 00 placeholders that keep the directories in the repo. A fresh
# clone must have no players so the first character created becomes Imm.
lib/plrfiles/*/*
!lib/plrfiles/*/00
lib/plrfiles/index
lib/plrobjs/*/*
!lib/plrobjs/*/00
lib/plrobjs/index

# Runtime logs and state
lib/etc/last
lib/etc/time
lib/etc/plrmail

# Bulletin board runtime content
lib/etc/board.immortal
lib/etc/board.mortal
lib/etc/board.social

# Server logs (all log/ except the README placeholder)
log/*
!log/README

# Root-level syslog files written by autorun / crash handler
syslog
syslog.CRASH

# Autoconf generated files
config.cache
config.log
config.status

# Backup and crash dump artifacts
changelog.bak
lib/circle.exe.stackdump

# Autorun sentinel files
.fastboot
.killscript
pause

# Python cache
tools/__pycache__/
**/__pycache__/
*.pyc

# .claude folder (Claude Code memory) -- do NOT ignore
# !.claude/
